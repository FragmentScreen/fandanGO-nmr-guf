# LOGS connection
LOGS_URL = https://bmrz.logs-repository.com/schwalbe/api/0.1
API_KEY = apikey

# ARIA connection
ARIA_CONNECTION_LOGIN_URL=https://auth.aria.services/auth/realms/ARIA/protocol/openid-connect/token
ARIA_GQL_BETA=https://graphql-beta.aria.services/graphql/api/graphql/access/v1
ARIA_FACILITY_ID=
ARIA_CONNECTION_USERNAME=
ARIA_CONNECTION_PASSWORD=
ARIA_CONNECTION_GRANT_TYPE=password
ARIA_CONNECTION_SCOPE=account
ARIA_CLIENT_ID=postman
ARIA_CLIENT_SECRET=
ARIA_KEYRING=aria_key
ARIA_CONNECTION_REFRESH_GRANT=refresh_token

# Optional public record URL included in the local deposition receipt.
# Required when explicitly enabling --write-back-logs yes (updates LOGS Notes).
# Set the host to your ARIA output service (use your local host for local tests).
# Supported placeholders: pid, visit_id, bucket_id, record_id, field_id.
ARIA_RECORD_URL_TEMPLATE=https://data.aria.services/result/{pid}/{visit_id}/render?bucket={bucket_id}&record={record_id}&fields={field_id}&format=html

# Local config
DEV=BETA
